# Base URL of the backend API
VITE_API_URL="http://localhost:3333"

# Server-side Vercel Function configuration. Never prefix either value with
# VITE_: they must not be included in the browser bundle. API_PROXY_TARGET is
# the Render backend origin only (no path). INTERNAL_PROXY_SECRET must contain
# the same independent, random value configured on the Render backend.
API_PROXY_TARGET=""
INTERNAL_PROXY_SECRET=""
