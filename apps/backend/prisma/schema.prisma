generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ATTENDANT
  TECHNICIAN
  /// Legacy/migration-only role. It remains temporarily while customer
  /// identities are separated from internal users in the next blocks.
  CUSTOMER
}

enum CustomerAccountStatus {
  ACTIVE
  SUSPENDED
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum ServiceOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  password         String
  role             UserRole       @default(ATTENDANT)
  isPrimaryAdmin   Boolean        @default(false)
  emailVerifiedAt  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  createdOrders    ServiceOrder[] @relation("CreatedOrders")
  technicianOrders ServiceOrder[] @relation("TechnicianOrders")
  refreshTokens           RefreshToken[]
  emailVerificationToken  EmailVerificationToken?
  passwordResetToken       PasswordResetToken?
  customer                Customer?
}

// Refresh tokens are stored as a hash (never the raw token) so a database
// leak alone can't be used to impersonate a session. Rotation on every use
// (see auth.service.ts) means a stolen-but-already-used token is a signal
// of theft, not just a valid credential.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  email         String?
  phone         String?
  document      String?        @unique
  address       String?
  /// Legacy User(CUSTOMER) link. It remains until an explicit reconciliation
  /// migrates legacy identities to CustomerAccount in a later block.
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceOrders ServiceOrder[]
}

// CustomerAccount is the future customer authentication identity. It is kept
// independent from User, which is reserved for internal staff identities.
model CustomerAccount {
  id              String                @id @default(uuid())
  customerId      String                @unique
  email           String                @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  status          CustomerAccountStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

// Public customer registration remains isolated here until e-mail ownership
// is confirmed. It never creates a legacy User(CUSTOMER) identity.
model PendingCustomerRegistration {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  document     String?
  address      String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  verificationToken PendingCustomerRegistrationToken?

  @@index([expiresAt])
}

// One current token per pending registration. Rotation replaces the stored
// HMAC, so every previously issued raw link becomes invalid immediately.
model PendingCustomerRegistrationToken {
  id                    String                      @id @default(uuid())
  pendingRegistrationId String                      @unique
  tokenHash             String                      @unique
  expiresAt             DateTime
  createdAt             DateTime                    @default(now())
  pendingRegistration   PendingCustomerRegistration @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ServiceOrder {
  id          String               @id @default(uuid())
  title       String
  description String
  status      ServiceOrderStatus   @default(OPEN)
  priority    ServiceOrderPriority @default(MEDIUM)

  customerId   String
  technicianId String?
  createdById  String

  customer   Customer @relation(fields: [customerId], references: [id])
  technician User?    @relation("TechnicianOrders", fields: [technicianId], references: [id])
  createdBy  User     @relation("CreatedOrders", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt(sort: Desc)])
  @@index([technicianId, createdAt(sort: Desc)])
}
