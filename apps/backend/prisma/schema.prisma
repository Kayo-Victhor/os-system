generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ATTENDANT
  TECHNICIAN
}

enum CustomerAccountStatus {
  ACTIVE
  SUSPENDED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum EmailOutboxType {
  CUSTOMER_REGISTRATION_VERIFICATION
  CUSTOMER_PASSWORD_RESET
  INTERNAL_PASSWORD_RESET
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CANCELLED
}

enum ServiceOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  email                  String                  @unique
  password               String
  role                   UserRole                @default(ATTENDANT)
  isPrimaryAdmin         Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  createdOrders          ServiceOrder[]          @relation("CreatedOrders")
  technicianOrders       ServiceOrder[]          @relation("TechnicianOrders")
  refreshTokens          RefreshToken[]
  passwordResetToken     PasswordResetToken?
}

// Refresh tokens are stored as a hash (never the raw token) so a database
// leak alone can't be used to impersonate a session. Rotation on every use
// (see auth.service.ts) means a stolen-but-already-used token is a signal
// of theft, not just a valid credential.
model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([usedAt])
}

model Customer {
  id              String           @id @default(uuid())
  name            String
  email           String?
  phone           String?
  document        String?          @unique
  address         String?
  customerAccount CustomerAccount?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  serviceOrders   ServiceOrder[]
}

// CustomerAccount is the customer authentication identity. It is independent
// from User, which is reserved exclusively for internal staff identities.
model CustomerAccount {
  id              String                @id @default(uuid())
  customerId      String                @unique
  email           String                @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  status          CustomerAccountStatus @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  customer           Customer                           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  passwordResetToken CustomerAccountPasswordResetToken?
  sessions            CustomerSession[]
}

// A customer authentication session is independent from the internal User
// refresh-token domain. Every rotated token remains as a hash in the family
// so reuse of any ancestor can revoke the whole session.
model CustomerSession {
  id                String          @id @default(uuid())
  customerAccountId String
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime        @default(now())
  lastUsedAt        DateTime?
  userAgent         String?
  ipAddress         String?
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  refreshTokens     CustomerSessionRefreshToken[]

  @@index([customerAccountId])
  @@index([expiresAt])
  @@index([customerAccountId, revokedAt])
  @@index([revokedAt])
}

model CustomerSessionRefreshToken {
  id                String          @id @default(uuid())
  customerSessionId String
  tokenHash         String          @unique
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime        @default(now())
  customerSession   CustomerSession @relation(fields: [customerSessionId], references: [id], onDelete: Cascade)

  @@index([customerSessionId])
  @@index([expiresAt])
  @@index([consumedAt])
}

// Password recovery for CustomerAccount is intentionally independent from
// the internal User/PasswordResetToken authentication domain.
model CustomerAccountPasswordResetToken {
  id                String          @id @default(uuid())
  customerAccountId String          @unique
  tokenHash         String          @unique
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime        @default(now())
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([usedAt])
}

// Public customer registration remains isolated here until e-mail ownership
// is confirmed. It never creates an internal User identity.
model PendingCustomerRegistration {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  document     String?
  address      String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verificationToken PendingCustomerRegistrationToken?

  @@index([expiresAt])
}

// One current token per pending registration. Rotation replaces the stored
// HMAC, so every previously issued raw link becomes invalid immediately.
model PendingCustomerRegistrationToken {
  id                    String                      @id @default(uuid())
  pendingRegistrationId String                      @unique
  tokenHash             String                      @unique
  expiresAt             DateTime
  createdAt             DateTime                    @default(now())
  pendingRegistration   PendingCustomerRegistration @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Transactional e-mail is persisted with the business state and delivered by
// a background worker. Delivery is at-least-once: a provider call that succeeds
// immediately before a process crash can be repeated on lease recovery.
model EmailOutbox {
  id                String            @id @default(uuid())
  type              EmailOutboxType
  recipient         String
  payload           Json
  status            EmailOutboxStatus @default(PENDING)
  attempts          Int               @default(0)
  availableAt       DateTime          @default(now())
  claimedAt         DateTime?
  sentAt            DateTime?
  providerMessageId String?
  lastError         String?
  deduplicationKey  String            @unique
  relatedEntityId   String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([type, relatedEntityId])
}

model ServiceOrder {
  id          String               @id @default(uuid())
  title       String
  description String
  status      ServiceOrderStatus   @default(OPEN)
  priority    ServiceOrderPriority @default(MEDIUM)

  customerId   String
  technicianId String?
  createdById  String

  customer   Customer @relation(fields: [customerId], references: [id])
  technician User?    @relation("TechnicianOrders", fields: [technicianId], references: [id])
  createdBy  User     @relation("CreatedOrders", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt(sort: Desc)])
  @@index([technicianId, createdAt(sort: Desc)])
}
