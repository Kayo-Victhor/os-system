# Used ONLY by the test suite (apps/backend/tests/setup.ts loads this file
# specifically — never .env). MUST point at a dedicated, disposable
# database: the suite deletes all rows from every table before each test.
#
# Vitest refuses to run unless this URL contains the word "test". Playwright
# is stricter: PostgreSQL on localhost/127.0.0.1/::1 and a database name ending
# in "_test". Never point this at the same database as your regular .env.
#
# JWT secrets and other app config for tests are set in vitest.config.ts
# (fake, non-sensitive fixed values) — only the database needs to be
# provided per-machine here.
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/os_system_test"

# Fictitious local-only values required when Playwright starts the real backend.
# Vitest replaces them with its own fixed test values. Never reuse in production.
JWT_ACCESS_SECRET="test-access-secret-not-for-real-use"
JWT_REFRESH_SECRET="test-refresh-secret-not-for-real-use"
NODE_ENV="test"
