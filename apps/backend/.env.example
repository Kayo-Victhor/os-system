# Postgres connection string used by Prisma
DATABASE_URL="postgresql://os_user:change_me@localhost:5432/os_system"

# Used to sign short-lived access tokens (15 min). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change_me"

# Refresh tokens themselves are opaque random strings (not JWTs), but this
# key is used to HMAC them before storing/looking them up in the database,
# so a database leak alone can't be used to enumerate or forge valid
# tokens. Generate the same way as JWT_ACCESS_SECRET, and keep it different
# from that value.
JWT_REFRESH_SECRET="change_me"

# HMAC secret used only to hash e-mail verification links. Generate and store
# independently from the JWT secrets. Required before public registration.
EMAIL_VERIFICATION_SECRET="change_me"
# Separate HMAC secret for password-reset links. Keep distinct from JWT and e-mail verification secrets.
PASSWORD_RESET_SECRET="change_me"

# Transactional e-mail for real address-ownership verification. The backend
# calls Brevo's HTTPS API directly; no key is exposed to the frontend.
EMAIL_PROVIDER="brevo"
BREVO_API_KEY=""
# An e-mail address verified in Brevo. A custom domain is not required for
# local testing while this sender is authorized in the Brevo account.
EMAIL_FROM="no-reply@example.com"
# Public frontend URL used in confirmation links. HTTPS is mandatory in production.
APP_BASE_URL="http://localhost:5173"

# Persistent transactional e-mail outbox worker. Defaults are conservative;
# tune only after observing the provider and database in the target environment.
EMAIL_OUTBOX_POLL_INTERVAL_MS="5000"
EMAIL_OUTBOX_BATCH_SIZE="10"
EMAIL_OUTBOX_MAX_ATTEMPTS="5"
EMAIL_OUTBOX_BACKOFF_BASE_MS="5000"

# Origin allowed to call this API with credentials (cookies).
#   - Development: optional. http://localhost:5173 (the Vite dev server)
#     is always allowed in addition to this, so you only need to set this
#     if you're also testing from some other origin.
#   - Production: required (the app throws at startup otherwise). Only
#     this origin is allowed — localhost is never included in production,
#     regardless of this value. Set to the deployed frontend's origin,
#     e.g. https://your-app.vercel.app.
CORS_ORIGIN="http://localhost:5173"

# Prefix the frontend's requests actually go through, if any. The backend's
# own routes are always /auth/..., /customers/..., etc. (see src/routes/) —
# this never changes. What changes is whether the *browser* reaches them
# directly or through a path-based rewrite:
#   - Local dev: leave this UNSET. The frontend calls
#     http://localhost:3333/auth/refresh directly, no rewrite involved.
#   - Production (Render): set to "/api". apps/frontend/vercel.json
#     rewrites /api/* on the Vercel origin to this backend, so the
#     frontend's actual request in production is /api/auth/refresh — this
#     value keeps the refresh-token cookie's Path in sync with that, or
#     the browser won't send the cookie back on refresh.
# Only affects the refresh-token cookie's Path; every other route is
# unaffected since the browser talks to Express directly regardless.
API_BASE_PATH=""

# development | production
NODE_ENV="development"

# Bootstrap credentials for the initial internal ADMIN (prisma/seed.ts).
# Set both in the environment; never commit real credentials.
ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
