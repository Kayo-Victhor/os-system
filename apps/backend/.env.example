# Postgres connection string used by Prisma
DATABASE_URL="postgresql://os_user:change_me@localhost:5432/os_system"

# Used to sign short-lived access tokens (15 min). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change_me"

# Refresh tokens themselves are opaque random strings (not JWTs), but this
# key is used to HMAC them before storing/looking them up in the database,
# so a database leak alone can't be used to enumerate or forge valid
# tokens. Generate the same way as JWT_ACCESS_SECRET, and keep it different
# from that value.
JWT_REFRESH_SECRET="change_me"

# Origin allowed to call this API with credentials (cookies). Required in
# production. Defaults to http://localhost:5173 (the Vite dev server) when
# unset outside production.
CORS_ORIGIN="http://localhost:5173"

# development | production
NODE_ENV="development"

# Optional: overrides the default seeded admin password (prisma/seed.ts).
# Always set this outside of local development.
SEED_ADMIN_PASSWORD=""
