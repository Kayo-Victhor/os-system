{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "noEmit": true,

    "types": ["node"],

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "prisma.config.ts",
    "prisma/seed.ts",
    "src/generated/prisma/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
